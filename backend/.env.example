# 复制为 backend/.env 后按需修改；backend/.env 已被 .gitignore 排除
# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=library_recommendation
DB_USERNAME=root
DB_PASSWORD=root

SERVER_PORT=8080

# -------------------- 大语言模型（OpenAI 兼容接口） --------------------
# 留空 AI_API_KEY 时，AI 对话会返回友好的配置提示，传统功能不受影响
AI_ENABLED=true
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_CHAT_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=60
AI_TEMPERATURE=0.3
AI_MAX_CONTEXT_BOOKS=6

# -------------------- Embedding 向量模型（OpenAI 兼容接口） --------------------
# 不填写时自动使用内置的本地哈希向量（无需联网，可演示语义检索流程）
# 推荐使用本项目 ai-service/embedding_server.py 加载 D:\mode\bge-base-zh-v1.5
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
